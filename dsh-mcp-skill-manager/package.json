{
  "name": "@local/dsh-mcp-skill-manager",
  "version": "0.1.0",
  "description": "Per-project enablement panel for host MCP servers and filesystem skills",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22",
    "dsh": "0.2.2-rc.1"
  },
  "packageManager": "pnpm@10.28.0",
  "exports": {
    ".": "./index.js",
    "./client": "./dist/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./assets/icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "src/host/",
    "src/shared/",
    "dist/client.js",
    "cordis.patch.yml",
    "assets/icon.svg",
    "locale/*.json",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "pretest": "pnpm run build",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "verify:bundle": "node --test --test-concurrency=1 test/bundle.test.js"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  }
}
