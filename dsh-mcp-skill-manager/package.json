{
  "name": "@local/dsh-mcp-skill-manager",
  "version": "0.2.0",
  "description": "Per-project MCP and skill policy with a Web settings panel and a dsh-go native panel",
  "private": true,
  "type": "module",
  "license": "MIT",
  "main": "./lib/index.js",
  "engines": {
    "node": ">=22",
    "dsh": "0.2.2-rc.1"
  },
  "packageManager": "pnpm@10.28.0",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./dist/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./assets/icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib/",
    "src/host/",
    "src/shared/",
    "dist/client.js",
    "cordis.patch.yml",
    "assets/icon.svg",
    "locale/*.json",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "dshGo": {
    "v": 1,
    "title": {
      "zh": "MCP 与 Skill",
      "en": "MCP & Skills"
    },
    "icon": "plugin",
    "contributes": {
      "composer.actions": [
        {
          "id": "open-policy",
          "label": {
            "zh": "MCP/技能",
            "en": "MCP/Skills"
          },
          "icon": "plugin",
          "effect": {
            "type": "open",
            "page": "panel:policy"
          }
        }
      ],
      "composer.tools": [
        {
          "id": "open-policy-tool",
          "label": {
            "zh": "MCP/技能",
            "en": "MCP"
          },
          "icon": "plugin",
          "panel": "policy"
        }
      ],
      "panels": [
        {
          "id": "policy",
          "title": {
            "zh": "MCP 与 Skill",
            "en": "MCP & Skills"
          },
          "icon": "plugin",
          "placement": [
            "session.tab",
            "features"
          ]
        }
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "pretest": "pnpm run build",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "verify:bundle": "node --test --test-concurrency=1 test/bundle.test.js"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  }
}
