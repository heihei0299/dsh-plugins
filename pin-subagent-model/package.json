{
  "name": "dsh-plugin-pin-subagent-model",
  "version": "0.3.0",
  "description": "Pin every delegated child Agent to one LLM route and show the route each subagent session actually used",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./icon": "./assets/icon.svg",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "assets/icon.svg",
    "locale/*.json",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "cordis",
    "subagent"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22",
    "dsh": "0.2.1-rc.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5"
  },
  "scripts": {
    "test": "node --test"
  }
}
