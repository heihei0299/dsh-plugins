{
  "name": "@local/dsh-history-budget",
  "version": "0.3.0",
  "description": "Bound the Web client's opening session frame and older history pages by encoded bytes; the native pager still reaches the trimmed entries",
  "private": true,
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./icon": "./assets/icon.svg",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "src/budget.js",
    "src/dsh-go/",
    "cordis.patch.yml",
    "assets/icon.svg",
    "locale/*.json",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dshGo": {
    "v": 1,
    "title": {
      "zh": "历史预算",
      "en": "History budget"
    },
    "icon": "plugin",
    "contributes": {
      "composer.actions": [
        {
          "id": "open-budget",
          "label": {
            "zh": "历史预算",
            "en": "History"
          },
          "icon": "plugin",
          "effect": {
            "type": "open",
            "page": "panel:history-budget"
          }
        }
      ],
      "panels": [
        {
          "id": "history-budget",
          "title": {
            "zh": "历史预算",
            "en": "History budget"
          },
          "icon": "plugin",
          "placement": [
            "session.tab",
            "features"
          ]
        }
      ]
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "cordis",
    "session",
    "history",
    "pagination"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22",
    "dsh": "0.2.1-rc.2 || 0.2.1-rc.5 || 0.2.2-rc.1 || 0.2.2-rc.2"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1"
  }
}
