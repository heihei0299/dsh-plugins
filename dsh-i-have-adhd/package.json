{
  "name": "dsh-i-have-adhd",
  "version": "0.2.0",
  "description": "ADHD-friendly output shaping for DeepSeek Harness: one system-prompt section plus /adhd on|off, action first, numbered steps, no preamble",
  "private": true,
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./icon": "./assets/icon.svg",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "src/rules.js",
    "src/dsh-go/",
    "cordis.patch.yml",
    "assets/icon.svg",
    "locale/*.json",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dshGo": {
    "v": 1,
    "title": {
      "zh": "ADHD 输出",
      "en": "ADHD output"
    },
    "icon": "plugin",
    "contributes": {
      "composer.actions": [
        {
          "id": "open-adhd",
          "label": {
            "zh": "ADHD",
            "en": "ADHD"
          },
          "icon": "plugin",
          "effect": {
            "type": "open",
            "page": "panel:adhd"
          }
        }
      ],
      "panels": [
        {
          "id": "adhd",
          "title": {
            "zh": "ADHD 输出",
            "en": "ADHD output"
          },
          "icon": "plugin",
          "placement": [
            "session.tab",
            "features"
          ]
        }
      ]
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "adhd",
    "output-style",
    "accessibility",
    "productivity"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22",
    "dsh": "0.2.2-rc.1 || 0.2.2-rc.2"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1"
  }
}
